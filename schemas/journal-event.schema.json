{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FrameBody": {
      "additionalProperties": false,
      "description": "Поля рамки без служебных: их хранят `frame.yaml` и событие В1.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/FrameField"
        },
        "decision_space": {
          "description": "Варианты решения: не меньше двух",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "title": "Decision Space",
          "type": "array"
        },
        "deadline": {
          "$ref": "#/$defs/FrameField"
        },
        "research_question": {
          "$ref": "#/$defs/FrameField"
        },
        "recipient": {
          "$ref": "#/$defs/FrameField"
        },
        "constraints": {
          "$ref": "#/$defs/FrameField"
        },
        "data": {
          "$ref": "#/$defs/FrameField"
        },
        "region": {
          "$ref": "#/$defs/FrameField"
        },
        "success_criteria": {
          "$ref": "#/$defs/FrameField"
        },
        "out_of_scope": {
          "$ref": "#/$defs/FrameField"
        }
      },
      "required": [
        "decision",
        "decision_space",
        "deadline",
        "research_question",
        "recipient",
        "constraints",
        "data",
        "region",
        "success_criteria",
        "out_of_scope"
      ],
      "title": "FrameBody",
      "type": "object"
    },
    "FrameField": {
      "additionalProperties": false,
      "description": "Поле рамки: значение и откуда оно.",
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "origin": {
          "enum": [
            "из запроса",
            "из материалов",
            "ответ человека",
            "допущение"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "pattern": "^И-[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Источник, если значение взято из материала",
          "title": "Source"
        }
      },
      "required": [
        "value",
        "origin"
      ],
      "title": "FrameField",
      "type": "object"
    },
    "GateEvent": {
      "additionalProperties": false,
      "description": "Событие ворот. Ожидание ответа не входит во время работы.",
      "properties": {
        "gate": {
          "enum": [
            "В1",
            "В2",
            "В3",
            "В4",
            "В5"
          ],
          "title": "Gate",
          "type": "string"
        },
        "mode": {
          "enum": [
            "пилот",
            "автопилот"
          ],
          "title": "Mode",
          "type": "string"
        },
        "questions": {
          "description": "Сколько вопросов задано человеку",
          "minimum": 0,
          "title": "Questions",
          "type": "integer"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "answered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Нет ответа — ворота прошли сообщением или ждут",
          "title": "Answered At"
        },
        "answer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameBody"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Только у В1: все поля рамки и откуда каждое"
        }
      },
      "required": [
        "gate",
        "mode",
        "questions",
        "opened_at"
      ],
      "title": "GateEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Строка `journal.jsonl`. Только добавление. Пишет только CLI.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "time": {
      "format": "date-time",
      "title": "Time",
      "type": "string"
    },
    "actor": {
      "enum": [
        "агент",
        "пользователь",
        "CLI",
        "хук"
      ],
      "title": "Actor",
      "type": "string"
    },
    "kind": {
      "enum": [
        "действие",
        "ворота",
        "ошибка",
        "исправление",
        "смена режима",
        "выбор модели",
        "изменено вне агента",
        "найдена инструкция в источнике",
        "бюджет",
        "учёт недоступен",
        "отказ хука",
        "граница прав не активна",
        "задание исследователю",
        "роль выполнена"
      ],
      "title": "Kind",
      "type": "string"
    },
    "step": {
      "enum": [
        "1",
        "2а",
        "2б",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ],
      "title": "Step",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Что за действие, например «запрос получен»",
      "title": "Name"
    },
    "message": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Пояснение или причина",
      "title": "Message"
    },
    "idempotency_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Ключ идемпотентности: хеш шага и входов",
      "title": "Idempotency Hash"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "начато",
            "выполнено",
            "ошибка",
            "пропущено",
            "прервано"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "duration_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Длительность действия, секунды",
      "title": "Duration S"
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateEvent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mode": {
      "anyOf": [
        {
          "enum": [
            "пилот",
            "автопилот"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Для смены режима",
      "title": "Mode"
    },
    "role": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Для выбора модели и «роль выполнена»: имя роли",
      "title": "Role"
    },
    "model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Для выбора модели",
      "title": "Model"
    },
    "level": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Для выбора модели: уровень (сильная, средняя, дешёвая)",
      "title": "Level"
    },
    "effort": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Для выбора модели: effort роли",
      "title": "Effort"
    },
    "source": {
      "anyOf": [
        {
          "pattern": "^И-[1-9][0-9]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Для найденной инструкции в источнике",
      "title": "Source"
    },
    "path": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?:[^/\\\\\\s\\x00.]|[^/\\\\\\s\\x00][^/\\\\\\x00]*[^/\\\\\\s\\x00.])(?:/(?:[^/\\\\\\s\\x00.]|[^/\\\\\\s\\x00][^/\\\\\\x00]*[^/\\\\\\s\\x00.]))*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Для «изменено вне агента»",
      "title": "Path"
    }
  },
  "required": [
    "schema_version",
    "time",
    "actor",
    "kind",
    "step"
  ],
  "title": "JournalEvent",
  "type": "object"
}
