{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "description": "Бюджет и расход. Денег может не быть: тогда лимит действует по времени.",
      "properties": {
        "limit_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Usd"
        },
        "spent_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Нет данных о стоимости — пусто",
          "title": "Spent Usd"
        },
        "limit_minutes": {
          "exclusiveMinimum": 0,
          "title": "Limit Minutes",
          "type": "number"
        },
        "spent_minutes": {
          "minimum": 0,
          "title": "Spent Minutes",
          "type": "number"
        }
      },
      "required": [
        "limit_minutes",
        "spent_minutes"
      ],
      "title": "Budget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Файл `state.yaml`. Пишет только CLI.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "пилот",
        "автопилот"
      ],
      "title": "Mode",
      "type": "string"
    },
    "step": {
      "enum": [
        "1",
        "2а",
        "2б",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ],
      "title": "Step",
      "type": "string"
    },
    "gates": {
      "additionalProperties": {
        "enum": [
          "впереди",
          "ждут ответа",
          "отвечено",
          "пройдены автоматически"
        ],
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "В1",
          "В2",
          "В3",
          "В4",
          "В5"
        ]
      },
      "title": "Gates",
      "type": "object"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "next_action": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Что делать дальше",
      "title": "Next Action"
    },
    "files": {
      "description": "sha256 файлов, которые пишет CLI: по ним замечают правки вне агента",
      "patternProperties": {
        "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$)).+$": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Files",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "mode",
    "step",
    "gates",
    "budget"
  ],
  "title": "ProjectState",
  "type": "object"
}
