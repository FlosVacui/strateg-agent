{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "deny": [
      "WebFetch",
      "Agent(general-purpose)",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(claude)",
      "Agent(statusline-setup)",
      "Agent(claude-code-guide)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(~/.strateg/**)",
      "Read(**/.tmp/pending/**)",
      "Read(evals/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--frozen",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "-X",
              "utf8",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py"
            ],
            "timeout": 120,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Monitor|Agent|Task|WebSearch|WebFetch)$|^mcp__.*(playwright|__browser_)",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--frozen",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "-X",
              "utf8",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_tool_use.py"
            ],
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--frozen",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "-X",
              "utf8",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post_tool_use_failure.py"
            ],
            "timeout": 120,
            "onFailure": "continue"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "uv run --frozen strateg status --line"
  }
}
